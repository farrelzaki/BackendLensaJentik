APP_NAME=LensaJentik
APP_ENV=local
APP_KEY=
# Di production Railway, set APP_ENV=production dan APP_DEBUG=false
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Di Railway: gunakan nilai dari tab Variables yang otomatis di-inject
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lensajentik
DB_USERNAME=postgres
DB_PASSWORD=

# ── Session & Cache ───────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Email (Mail) ──────────────────────────────────────────────────────────────
# Lokal: gunakan Mailtrap atau log
# Production Railway: gunakan Resend (MAIL_MAILER=resend, RESEND_API_KEY=re_xxx)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@lensajentik.id"
MAIL_FROM_NAME="LensaJentik"

# Wajib diisi di Railway jika menggunakan Resend:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# ── Cloudinary (Upload Foto Laporan) ─────────────────────────────────────────
# Wajib diisi di Railway! Dapat dari dashboard cloudinary.com
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── CORS (Frontend URL) ───────────────────────────────────────────────────────
# Di production Railway: isi dengan domain frontend aktual, pisahkan koma jika lebih dari 1
# Contoh: FRONTEND_URL=https://lensajentik.vercel.app
# Di lokal: biarkan kosong (otomatis wildcard '*')
FRONTEND_URL=*

VITE_APP_NAME="${APP_NAME}"
